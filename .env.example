# Path to the SQLite database file. In Docker this points at a mounted volume, e.g. file:/data/app.db
DATABASE_URL="file:./dev.db"

# Base URL of this app, used server-side to build absolute image URLs when rendering PDFs.
# In production this is the site's own domain: https://kayttajayhteiso.fi
APP_URL="http://localhost:3000"
