generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  SERVICE
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum EditionStatus {
  DRAFT
  FINAL
}

enum ZineContentType {
  ALERT
  ARTICLE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  serviceName  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  alerts       Alert[]
  articles     Article[]
  streetRounds StreetRound[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Alert {
  id            String    @id @default(cuid())
  serviceUserId String
  title         String
  body          String
  validFrom     DateTime?
  validUntil    DateTime?
  includeInZine Boolean   @default(true)
  archived      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  service User @relation(fields: [serviceUserId], references: [id])

  @@index([serviceUserId])
}

model Article {
  id            String        @id @default(cuid())
  authorId      String
  title         String
  body          String
  imagePath     String?
  status        ArticleStatus @default(DRAFT)
  includeInZine Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model StreetRound {
  id        String   @id @default(cuid())
  authorId  String
  date      DateTime
  participants String?
  area      String?
  notes     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model ZineEdition {
  id          String        @id @default(cuid())
  startDate   DateTime
  endDate     DateTime
  status      EditionStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  publishedAt DateTime?
  pdfPath     String?
  coverNote   String?

  items ZineItem[]

  @@unique([startDate, endDate])
}

model ZineItem {
  id             String          @id @default(cuid())
  editionId      String
  contentType    ZineContentType
  sourceId       String
  titleSnapshot  String
  bodySnapshot   String
  authorSnapshot String
  imageSnapshot  String?
  metaSnapshot   String?
  sortOrder      Int             @default(0)
  excluded       Boolean         @default(false)

  edition ZineEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, contentType, sourceId])
  @@index([editionId])
}

model SiteSettings {
  id            Int    @id @default(1)
  orgName       String @default("Tampereen Käyttäjäyhteisö")
  description   String @default("")
  contactInfo   String @default("")
  socialInfo    String @default("")
  backPageText  String @default("")
  logoPath      String @default("/branding/logo.jpeg")
}

/// A directory entry for the public "Tampereen palvelut" service map,
/// sourced from a hand-maintained list of local services (see
/// prisma/data/). Not the same thing as a service Account/Alert — this is
/// reference info anyone can browse, with no login involved.
model DirectoryService {
  id          String   @id @default(cuid())
  category    String
  name        String
  address     String?
  phone       String?
  description String?
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now())

  experiences Experience[]

  @@unique([category, name])
}

/// A weekly-recurring Tampere NA (Narcotics Anonymous) meeting, synced from
/// NA Suomi's public meeting API (see scripts/fetch-na-meetings.mjs).
/// weekday/weekdayIndex/time describe the recurring weekly slot, not a
/// single date — there is no per-occurrence row.
model NaMeeting {
  id              String    @id @default(cuid())
  sourceId        Int       @unique
  name            String
  weekday         String
  weekdayIndex    Int
  time            String
  durationMinutes Int?
  address         String?
  postalCode      String?
  city            String
  notes           String?
  formats         String?
  mapLink         String?
  lat             Float?
  lng             Float?
  cancelled       Boolean   @default(false)
  onBreakUntil    DateTime?
  sourceUrl       String?
  createdAt       DateTime  @default(now())

  experiences Experience[]

  @@index([weekdayIndex])
}

/// An anonymous short public note ("Kokemus") about either a
/// DirectoryService or an NaMeeting — exactly one of serviceId/meetingId
/// is set. No account, no author field by design; ipAddress is recorded
/// (disclosed to posters) purely so admins can moderate abuse via
/// BannedIp, and is never shown to other visitors.
model Experience {
  id        String   @id @default(cuid())
  serviceId String?
  meetingId String?
  body      String
  ipAddress String?
  createdAt DateTime @default(now())

  service DirectoryService? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  meeting NaMeeting?        @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([meetingId])
  @@index([createdAt])
}

/// An IP address temporarily blocked from posting new Experience rows.
/// Applies to both services and meetings — abuse from one IP is abuse
/// regardless of which page it targeted.
model BannedIp {
  id          String   @id @default(cuid())
  ipAddress   String   @unique
  reason      String?
  bannedUntil DateTime
  createdAt   DateTime @default(now())
}
