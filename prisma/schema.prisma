generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  SERVICE
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum EditionStatus {
  DRAFT
  FINAL
}

enum ZineContentType {
  ALERT
  ARTICLE
  EVENT
}

/// areaId is the user's home area. An ADMIN without one is a national
/// admin (every area, plus the national settings); an ADMIN with one is an
/// area admin. MEMBER and SERVICE accounts need an area for anything tied to
/// a place (alerts, events, street rounds) — articles are national, so a
/// member writes those whatever their area.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  serviceName  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  areaId       String?

  area Area? @relation(fields: [areaId], references: [id])

  alerts       Alert[]
  articles     Article[]
  streetRounds StreetRound[]
  events       CommunityEvent[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Alert {
  id            String    @id @default(cuid())
  areaId        String
  serviceUserId String
  title         String
  body          String
  validFrom     DateTime?
  validUntil    DateTime?
  includeInZine Boolean   @default(true)
  archived      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  area    Area @relation(fields: [areaId], references: [id])
  service User @relation(fields: [serviceUserId], references: [id])

  @@index([areaId])
  @@index([serviceUserId])
}

/// National: an article has no area. It is listed at /artikkelit and runs in
/// every area's paper.
model Article {
  id                String        @id @default(cuid())
  authorId          String
  title             String
  body              String
  imagePath         String?
  status            ArticleStatus @default(DRAFT)
  /// The author's own choice to offer the article to the papers.
  includeInZine     Boolean       @default(true)
  /// Set by a national admin to keep the article out of every area's paper
  /// at once (it stays on the site). Separate from includeInZine so an
  /// author saving their article never undoes it.
  excludedFromZines Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

/// A meeting or event the community itself is putting on ("Käyttäjäyhteisön
/// kokoukset ja tapahtumat") — added by members, listed publicly, and
/// printed in the zine right after the page introducing the organisation.
/// Unlike an Alert (a service announcing something to its users) this is the
/// community's own calendar, so it is authored by MEMBER/ADMIN accounts.
model CommunityEvent {
  id            String    @id @default(cuid())
  areaId        String
  authorId      String
  title         String
  startsAt      DateTime
  /// Optional: set only for events that run across a span worth printing.
  endsAt        DateTime?
  location      String?
  body          String
  includeInZine Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  area   Area @relation(fields: [areaId], references: [id])
  author User @relation(fields: [authorId], references: [id])

  @@index([areaId])
  @@index([authorId])
  @@index([startsAt])
}

/// `place` is the free-text part of town the round covered ("Keskusta,
/// Hervanta"); it was called `area` until areas became their own model.
model StreetRound {
  id           String   @id @default(cuid())
  areaId       String
  authorId     String
  date         DateTime
  participants String?
  place        String?
  notes        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  area   Area @relation(fields: [areaId], references: [id])
  author User @relation(fields: [authorId], references: [id])

  @@index([areaId])
  @@index([authorId])
}

/// One paper per area per week.
model ZineEdition {
  id          String        @id @default(cuid())
  areaId      String
  startDate   DateTime
  endDate     DateTime
  status      EditionStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  publishedAt DateTime?
  pdfPath     String?
  coverNote   String?

  area  Area       @relation(fields: [areaId], references: [id])
  items ZineItem[]

  @@unique([areaId, startDate, endDate])
}

model ZineItem {
  id             String          @id @default(cuid())
  editionId      String
  contentType    ZineContentType
  sourceId       String
  titleSnapshot  String
  bodySnapshot   String
  authorSnapshot String
  imageSnapshot  String?
  metaSnapshot   String?
  sortOrder      Int             @default(0)
  excluded       Boolean         @default(false)

  edition ZineEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, contentType, sourceId])
  @@index([editionId])
}

/// The national community's settings: one row. Anything that differs by
/// place (contact addresses, Telegram group, the area's own about text) is
/// on Area instead.
model SiteSettings {
  id            Int    @id @default(1)
  orgName       String @default("Käyttäjäyhteisö")
  description   String @default("")
  /// Longer Markdown body for the public /tietoa page specifically —
  /// kept separate from `description` (the short blurb also printed on
  /// the zine's back cover), so this can be as long as needed.
  aboutText     String @default("")
  backPageText  String @default("")
  logoPath      String @default("/branding/kayttajayhteiso.jpg")
  /// The site's root URL. An area's own address is this plus /<area>, and
  /// that is what the area's paper prints (with a QR code).
  publicSiteUrl String @default("https://kayttajayhteiso.fi")
}

/// A place the community operates in, with its own section of the site
/// (/<id>) and its own weekly paper. The id is the URL slug itself
/// ("tampere"), since it is printed in QR codes and can never change.
///
/// The name comes in the three forms Finnish headings need, so no page has
/// to inflect a place name in code: "Tampereen palvelut" (genitive),
/// "NA-ryhmiä Tampereella" (inessive).
model Area {
  id              String   @id
  name            String
  nameGenitive    String
  nameInessive    String
  /// Comma-separated `kaupunki` values in the nasuomi.org meeting API that
  /// belong to this area, e.g. "Helsinki,Espoo,Vantaa,Kauniainen".
  naCityNames     String   @default("")
  mapLat          Float
  mapLng          Float
  mapZoom         Int      @default(12)
  /// An inactive area 404s publicly; it stays off until it has a services
  /// list, an admin and a first paper.
  active          Boolean  @default(false)
  sortOrder       Int      @default(0)
  /// Markdown shown at the top of the area's front page, under its name.
  aboutText       String   @default("")
  /// Area email: mailto link and QR code on /tietoa and the area page.
  contactInfo     String   @default("")
  /// Area Telegram link, with a QR code.
  socialInfo      String   @default("")
  /// Shown on the last page of this area's paper ("write for the next
  /// issue"), with a mailto: QR code.
  submissionEmail String   @default("")
  createdAt       DateTime @default(now())

  users        User[]
  alerts       Alert[]
  events       CommunityEvent[]
  streetRounds StreetRound[]
  editions     ZineEdition[]
  services     DirectoryService[]
  naMeetings   NaMeeting[]
}

/// A directory entry for an area's public service map ("Tampereen palvelut"),
/// sourced from a hand-maintained list of local services (see
/// prisma/data/). Not the same thing as a service Account/Alert — this is
/// reference info anyone can browse, with no login involved.
model DirectoryService {
  id          String   @id @default(cuid())
  areaId      String
  category    String
  name        String
  address     String?
  phone       String?
  description String?
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now())

  area        Area         @relation(fields: [areaId], references: [id])
  experiences Experience[]

  @@unique([areaId, category, name])
}

/// A weekly-recurring NA (Narcotics Anonymous) meeting in one area, synced from
/// NA Suomi's public meeting API (see scripts/fetch-na-meetings.mjs).
/// weekday/weekdayIndex/time describe the recurring weekly slot, not a
/// single date — there is no per-occurrence row.
model NaMeeting {
  id              String    @id @default(cuid())
  areaId          String
  sourceId        Int       @unique
  name            String
  weekday         String
  weekdayIndex    Int
  time            String
  durationMinutes Int?
  address         String?
  postalCode      String?
  city            String
  notes           String?
  formats         String?
  mapLink         String?
  lat             Float?
  lng             Float?
  cancelled       Boolean   @default(false)
  onBreakUntil    DateTime?
  sourceUrl       String?
  createdAt       DateTime  @default(now())

  area        Area         @relation(fields: [areaId], references: [id])
  experiences Experience[]

  @@index([areaId])
  @@index([weekdayIndex])
}

/// An anonymous short public note ("Kokemus") about a DirectoryService.
/// Has no area of its own: it takes its service's.
/// No account, no author field by design; ipAddress is recorded
/// (disclosed to posters) purely so admins can moderate abuse via
/// BannedIp, and is never shown to other visitors.
///
/// meetingId is retained only for rows written while NA meetings also
/// accepted Kokemukset: that was removed (a meeting is not a service to
/// be reviewed), so nothing writes meetingId any more and no public page
/// reads it — admins can still find and delete those rows in
/// /admin/kokemukset.
model Experience {
  id        String   @id @default(cuid())
  serviceId String?
  meetingId String?
  body      String
  ipAddress String?
  createdAt DateTime @default(now())

  service DirectoryService? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  meeting NaMeeting?        @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([meetingId])
  @@index([createdAt])
}

/// An IP address temporarily blocked from posting new Experience rows.
/// Applies to both services and meetings — abuse from one IP is abuse
/// regardless of which page it targeted.
model BannedIp {
  id          String   @id @default(cuid())
  ipAddress   String   @unique
  reason      String?
  bannedUntil DateTime
  createdAt   DateTime @default(now())
}
